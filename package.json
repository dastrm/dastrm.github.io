{
	"name": "dastrm.github.io",
	"private": true,
	"license": "MIT",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "npx svelte-sitemap --domain https://dastrm.github.io && shx cp build/404/index.html build/404.html",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"sass-embedded": "^1.107.0",
		"shx": "^0.4.0",
		"svelte": "^5.49.1",
		"svelte-check": "^4.7.7",
		"svelte-sitemap": "^4.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"@fontsource/merriweather": "^5.2.11",
		"@fontsource/ubuntu-mono": "^5.2.8"
	}
}
